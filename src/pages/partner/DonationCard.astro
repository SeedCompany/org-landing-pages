---
import { fetchPartnerTotals } from './partner-totals.ts';
import ProjectCards from './ProjectCards.astro';
import { withStartAmounts } from './donationTiers.ts';
import type { PartnerCampaign } from './partnerBySlug.groq';

interface Props {
  campaignData: PartnerCampaign;
}

const { campaignData } = Astro.props;

const { amount: fetchedAmount } = await fetchPartnerTotals(campaignData.sfCode);
const amountOverride = Astro.url.searchParams.get('amount');
const amount = amountOverride ? parseInt(amountOverride, 10) : fetchedAmount;

const sanityTiers = withStartAmounts(campaignData.donationTiers ?? []);
---

<ProjectCards
  projectData={sanityTiers
    .filter((tier) => !tier.hidden || amount >= tier.startAmount)
    .map((tier) => ({
      currentAmount: amount,
      startAmount: tier.startAmount,
      endAmount: tier.endAmount ?? 0,
      peopleGroups: tier.peopleGroups ?? 0,
      image: tier.image?.asset?.url ?? '',
      projectHeader: tier.projectHeader ?? '',
      projectDescription: tier.projectDescription ?? '',
      projectBullets: tier.projectBullets ?? [],
      languageProjects: tier.languageProjects?.projects?.length
        ? {
            heading: tier.languageProjects.heading ?? undefined,
            linkText: tier.languageProjects.linkText ?? undefined,
            projects: tier.languageProjects.projects.map((p) => ({
              languageName: p.languageName ?? '',
              country: p.country ?? undefined,
              region: p.region ?? '',
              milestone: p.milestone ?? '',
              sensitivity: (p.sensitivity ?? 'low') as 'low' | 'medium' | 'high',
              amount: p.amount ?? 0,
            })),
          }
        : undefined,
    }))}
/>
