---
const { title, content, htmlContent = false, className } = Astro.props;
---

<section class={`about-section ${className ?? ''}`}>
  {
    title &&
      (htmlContent ? (
        <h2 class="about-heading" set:html={title} />
      ) : (
        <h2 class="about-heading">{title}</h2>
      ))
  }

  {
    htmlContent ? (
      <div class="about-content prose max-w-none" set:html={content} />
    ) : (
      <p class="about-content">{content}</p>
    )
  }
</section>

<style>
  .about-section {
    margin-bottom: 2rem;
  }
  .about-heading {
    font-family: 'Gotham Bold', sans-serif;
    font-weight: bold;
    font-size: 2.25rem;
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: #323232;
    margin-bottom: 1rem;
  }
  .about-content {
    font-size: 1.1rem;
    line-height: 1.6;
    color: #323232;
  }
</style>
