---
import { sanityClient as sanity } from '~/sanity';
import { fetchPartnerTotals } from './partner-totals.ts';
import { DonationForm as DonationFormIsland } from './DonationForm.tsx';
import CampaignGivingInfo from './CampaignGivingInfo.astro';
import { withStartAmounts } from './donationTiers.ts';
import type { PartnerCampaign } from './partnerBySlug.groq';

interface Props {
  disableDialog?: boolean;
  campaignData: PartnerCampaign;
}

const { disableDialog, campaignData } = Astro.props;

const { amount: fetchedAmount } = await fetchPartnerTotals(campaignData.sfCode);

const amountOverride = Astro.url.searchParams.get('amount');
const totalRaised = amountOverride ? parseInt(amountOverride, 10) : fetchedAmount;

// Goal = the highest end amount among the tiers currently showing (same visibility
// rule as the cards: always-visible tiers, plus hidden ones the raised amount has unlocked).
const visibleTiers = withStartAmounts(campaignData.donationTiers ?? []).filter(
  (tier) => !tier.hidden || totalRaised >= tier.startAmount,
);
const goalAmount = visibleTiers.length
  ? Math.max(...visibleTiers.map((tier) => tier.endAmount ?? 0))
  : totalRaised;

const campaignTotals = {
  totalRaised,
  goalAmount,
};

// ?campaign=active forces the live form state; ?campaign=notstarted forces "before start"; ?campaign=ended forces the ended state
const campaignStateOverride = Astro.url.searchParams.get('campaign');
const yesterday = new Date(Date.now() - 86400000).toISOString().slice(0, 10);
const tomorrow = new Date(Date.now() + 86400000).toISOString().slice(0, 10);
const overrideStartDate =
  campaignStateOverride === 'notstarted'
    ? tomorrow
    : campaignStateOverride === 'active' || campaignStateOverride === 'ended'
      ? yesterday
      : undefined;
const overrideEndDate =
  campaignStateOverride === 'ended'
    ? yesterday
    : campaignStateOverride === 'active'
      ? tomorrow
      : undefined;

const forceDisabled = Astro.url.searchParams.get('form') === 'disabled';

// Donation form config sourced from the Sanity "Donation Form" section.
const donationForm = campaignData.donationForm;
const DEFAULT_PRESETS = [50, 100, 300, 500, 1000];

// Cadence + presets from Sanity. Each preset list falls back to defaults when missing
// or empty so the form never renders zero preset buttons.
const donationType = donationForm?.donationType ?? 'oneTime';
const oneTimePresets = donationForm?.oneTimePresets?.length
  ? donationForm.oneTimePresets
  : DEFAULT_PRESETS;
const recurringPresets = donationForm?.recurringPresets?.length
  ? donationForm.recurringPresets
  : DEFAULT_PRESETS;

// Give by check: shown only when enabled in Sanity; memo line included when provided.
const giveByMail = donationForm?.giveByMail?.enabled
  ? { memo: donationForm.giveByMail.memo ?? undefined }
  : (false as const);
---

<div class="form-card lg:min-w-96 p-5 rounded-lg shadow-lg z-10">
  <DonationFormIsland
    formProps={{
      donationType,
      investorType: donationForm?.giverType ?? 'both',
      presetAmounts: {
        oneTime: oneTimePresets,
        recurring: recurringPresets,
      },
      campaignTotals: true,
      forceDisabled,
      campaignStartDate: overrideStartDate ?? campaignData.campaignStartDate ?? undefined,
      campaignEndDate: overrideEndDate ?? campaignData.campaignEndDate ?? undefined,
      logoUrl: campaignData.heroImage ? sanity.image(campaignData.heroImage).url() : undefined,
      logoAlt: campaignData.heroImageAlt ?? undefined,
      giveByMail,
      returnPath: Astro.url.pathname,
      // Attribution: send the Salesforce short code as the referrer, mirroring the
      // (proven) Watermark page so donations land on the correct campaign.
      telemetry: { referrer: campaignData.sfCode ?? undefined },
    }}
    disableDialog={disableDialog}
    client:load
  >
    <CampaignGivingInfo
      campaignTotals={campaignTotals}
      donationTiers={campaignData.donationTiers}
      slot="campaign-progress"
    />
  </DonationFormIsland>
</div>
