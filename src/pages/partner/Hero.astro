---
import { portableText, sanityClient as sanity } from '~/sanity';
import type { PartnerCampaign } from './partnerBySlug.groq';

interface Props {
  campaignData: PartnerCampaign;
}

const { campaignData } = Astro.props;
const heroImageUrl = campaignData.heroImage ? sanity.image(campaignData.heroImage).url() : null;

// When enabled, place the logo on a light chip (same Natural fill as the donation form)
// so a dark logo stays legible on the dark hero. Otherwise render it flush as before.
const logoClass = campaignData.logoBackground
  ? 'logo h-auto w-3/4 sm:w-1/2 md:w-1/2 bg-scNatural p-4 rounded-xl'
  : 'logo -ml-6 h-auto sm:-ml-5 w-3/4 sm:w-1/2 md:w-1/2';
---

<div class="md:w-3/4">
  <div>
    {
      heroImageUrl && (
        <img src={heroImageUrl} alt={campaignData.heroImageAlt || ''} class={logoClass} />
      )
    }
    {
      campaignData.heading && (
        <h1
          class="hero-h1 uppercase text-pretty"
          set:html={portableText.toHTML(campaignData.heading)}
        />
      )
    }
    {
      campaignData.subheading && (
        <span class="hero-sub-heading uppercase text-pretty">{campaignData.subheading}</span>
      )
    }
    {
      campaignData.heroCopy && (
        <div
          class="hero-p mt-6 mb-6 text-pretty max-w-full md:max-w-lg text-base"
          set:html={portableText.toHTML(campaignData.heroCopy)}
        />
      )
    }
  </div>
</div>
