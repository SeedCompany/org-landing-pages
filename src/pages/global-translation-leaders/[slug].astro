---
import * as editorJs from '~/editorjs';
import { graphql, graphqlClient } from '~/graphql';
import { portableText } from '~/sanity';
import MainLayout from '~/layouts/main/MainLayout.astro';
import { DonationForm } from '~/features/donate';
import { calcGtlFunding } from './_funding';

const SponsorDetailDoc = graphql(`
  query SponsorDetail($id: ID!) {
    globalTranslationLeader(id: $id) {
      id
      shortCode
      name
      region
      gender
      focus
      biography
      image
      endDate
      funding {
        remaining(applyPledges: true)
      }
    }
  }
`);

const { slug } = Astro.params as { slug: string };
const { data } = await graphqlClient.query(SponsorDetailDoc, { id: slug }).toPromise();
const sponsor = data?.globalTranslationLeader;
if (!sponsor) {
  return Astro.redirect('/404');
}
const isSponsored = sponsor.funding.remaining === 0;

const { monthlyNeed, monthlyRaised } = calcGtlFunding(
  sponsor.funding.remaining,
  sponsor.endDate as string,
);
---

<MainLayout title={`${sponsor.name} - Global Translation Leader`}>
  <div class="bg-[var(--sus-primary-heading)] min-h-screen text-white py-12 gotham">
    <div class="container border-white border-2 rounded-lg mx-auto p-8 md:py-12">
      <div class="mb-8">
        <a
          href={`/global-translation-leaders#${slug}`}
          class="text-[var(--sus-button-secondary-bg)] hover:underline"
        >
          ← Back to Global Translation Leaders
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-[1fr_1fr_2fr] gap-6 items-start">
        <div class="md:col-start-1 md:row-start-1">
          {
            sponsor.image && (
              <img
                src={sponsor.image}
                alt={`Photo of ${sponsor.name}`}
                class={`rounded-lg w-full max-h-84 object-cover object-top ${isSponsored ? 'grayscale opacity-40' : ''}`}
              />
            )
          }
        </div>

        <div class="md:col-start-2 md:row-start-1">
          <h1 class="text-4xl lg:text-6xl font-bold mb-4">{sponsor.name}</h1>
          <div class="grid grid-cols-2 gap-x-4 gap-y-1 mb-6">
            <p><strong>Region:</strong> {sponsor.region}</p>
            <p><strong>Gender:</strong> {sponsor.gender}</p>
            <p><strong>GTL ID:</strong> {sponsor.shortCode}</p>
            <p><strong>Focus:</strong> {sponsor.focus}</p>
          </div>
        </div>

        <div class="md:col-start-3 md:row-start-1 md:row-span-2">
          {
            !isSponsored ? (
              <div class="p-6 rounded-lg bg-white text-gray-900">
                <p class="text-sm text-gray-500 mb-3 text-center">
                  All GTL sponsorships are monthly recurring gifts.
                </p>
                {sponsor.funding.remaining > 0 && (
                  <div class="mb-4">
                    <div class="flex justify-between text-sm text-gray-600 mb-1">
                      <span>${monthlyRaised.toLocaleString()} / mo raised</span>
                      <span>${monthlyNeed.toLocaleString()} / mo remaining</span>
                    </div>
                    <div class="w-full bg-gray-200 rounded-full h-2">
                      <div
                        class="bg-green-500 h-2 rounded-full"
                        style={`width: ${((monthlyRaised / 1000) * 100).toFixed(0)}%`}
                      />
                    </div>
                  </div>
                )}
                <DonationForm
                  amount={{
                    presets: [250, 500, 750, 1000],
                    min: { value: 250, message: 'At least $250 please' },
                  }}
                  intent={{
                    program: 'GlobalTranslationLeaders',
                    engagement: sponsor.id,
                  }}
                  cadence={{
                    options: ['Monthly'],
                  }}
                  telemetry={{
                    app: 'seed.bible',
                    feature: 'gtl',
                    sourceUrl: Astro.url.toString(),
                  }}
                  giveByMail={false}
                  client:load
                />
              </div>
            ) : (
              <div class="bg-[var(--sus-button-secondary-bg)] text-black p-4 rounded-lg">
                <p class="font-semibold">This leader is currently sponsored!</p>
              </div>
            )
          }
        </div>

        <div class="md:col-start-1 md:col-span-2 md:row-start-2">
          <h2 class="text-2xl font-bold mb-4">Biography</h2>
          <div
            class="prose prose-invert md:prose-lg max-w-none"
            set:html={portableText.toHTML(editorJs.toPortableText(sponsor.biography))}
          />
        </div>
      </div>
    </div>
  </div>
</MainLayout>
